        <script><![CDATA[var DoppelUIHelper = Class.create();
DoppelUIHelper.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    getDoppelLink: function () {
        var obsId = String(this.getParameter('sysparm_obs_id') || '');
        var obs = new GlideRecord('sn_ti_observable');
        if (!obsId || !obs.get(obsId) || !obs.canRead()) return '';
        return new DoppelIOCImport().getLatestDoppelLink(obsId);
    },

    type: 'DoppelUIHelper'
});]]></script>
