        <name>Doppel Lookup</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[try {
	var doppel = new DoppelIOCImport();
    var result = doppel.lookupIndicator(current.value.toString(), false);

    current.x_doppe_doppel_t_0_lookup_last_checked = new GlideDateTime();
    if (result.error) {
        gs.addErrorMessage('Doppel lookup failed: ' + result.error);
    } else if (!result.hit) {
        current.x_doppe_doppel_t_0_lookup_status = 'no_match';
        gs.addInfoMessage('Doppel lookup: no match found');
    } else {
        current.x_doppe_doppel_t_0_lookup_status = 'hit';
        current.x_doppe_doppel_t_0_lookup_alert_id = result.alert_id || '';
        current.x_doppe_doppel_t_0_lookup_brand = result.brand || '';
        current.x_doppe_doppel_t_0_lookup_product_type = result.product_type || '';
        current.x_doppe_doppel_t_0_lookup_queue_state = result.queue_state || '';
        current.x_doppe_doppel_t_0_lookup_entity_state = result.entity_state || '';
        current.x_doppe_doppel_t_0_lookup_vision_url = result.doppel_link || '';
        gs.addInfoMessage('Doppel lookup: hit');
    }
    current.update();
} catch (e) {
    gs.addErrorMessage('Doppel lookup error: ' + e.message);
}
action.setRedirectURL(current.getLink(true) + '&sysparm_view=doppel-ti');]]></script>
