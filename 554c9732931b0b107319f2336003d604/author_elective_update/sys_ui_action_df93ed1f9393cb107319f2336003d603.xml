        <name>Doppel Submit</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[  try {
      var doppel = new DoppelIOCImport();
      var createResult = doppel.createAlertInDoppel(current.value.toString());
      if (!createResult.success) {
          gs.addErrorMessage('Doppel submit failed: ' + createResult.error);
      } else {
          current.x_doppe_doppel_t_0_doppel_owned = true;
          current.update();
          gs.addInfoMessage(createResult.alreadyExisted
              ? 'Already exists in Doppel (alert ' + createResult.data.id + ').'
              : 'Submitted to Doppel — alert ' + createResult.data.id + ' created.');
          // Record Doppel's current state as a native Threat Lookup Result
          doppel.runCapabilityThreatLookup({ sn_ti_observable: [current.getUniqueValue()] }, null);
          gs.addInfoMessage('Run Threat Lookup to update this observable\'s overall Finding.');
      }
  } catch (e) {
      gs.addErrorMessage('Doppel submit error: ' + e.message);
  }
  action.setRedirectURL(current);]]></script>
