        <name>Open in Doppel Vision</name>
        <onclick>onClick()</onclick>
        <order>100</order>
        <script><![CDATA[  function onClick() {
      // Open the tab immediately (inside the click) so popup blockers allow it
      var win = top.window.open('', '_blank');
      var ga = new GlideAjax('x_doppe_doppel_t_0.DoppelUIHelper');
      ga.addParam('sysparm_name', 'getDoppelLink');
      ga.addParam('sysparm_obs_id', g_form.getUniqueValue());
      ga.getXMLAnswer(function (url) {
          if (url) {
              if (win) { win.location.href = url; win.focus(); }
              else { top.window.open(url, '_blank'); }
          } else {
              if (win) win.close();
              g_form.addErrorMessage('No Doppel Vision link available — run Threat Lookup first.');
          }
      });
  }]]></script>
